# Copier ce fichier en .env et compléter. Ne jamais publier le fichier .env.

# Adresse publique du site (HTTPS obligatoire en production)
SITE_URL=https://assurance-voyage.exemple.ma
# Mot de passe de l'espace cabinet (/admin)
ADMIN_PASSWORD=
# Clé secrète longue et aléatoire (générée automatiquement si vide)
SECRET_KEY=

# ── Paiement YouCan Pay (prioritaire) : clés du tableau de bord YouCan Pay, rubrique Paramètres.
# Clés de test « pri_sandbox_… / pub_sandbox_… » : aucune carte débitée. Clés réelles « pri_… / pub_… » : encaissement réel.
# Webhook à déclarer chez YouCan Pay : https://VOTRE-SITE/paiement/youcanpay/webhook (événements transaction.paid et transaction.failed)
YCP_PRIVATE_KEY=
YCP_PUBLIC_KEY=

# ── Paiement CMI (fourni par la banque après signature du contrat commerçant)
# Sans ces deux valeurs, le site reste en mode démonstration.
CMI_CLIENT_ID=
CMI_STORE_KEY=
# Test : https://testpayment.cmi.co.ma/fim/est3Dgate  ·  Production : https://payment.cmi.co.ma/fim/est3Dgate
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# ── Lecture automatique des CIN / passeports (clé API Anthropic : console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Portail Maroc Assistance (portail.mai.ma)
# manuel | validation (un conseiller clique « Émettre via le portail ») | auto
MAI_MODE=validation
MAI_LOGIN=
MAI_PASSWORD=
MAI_SCENARIO=mai_scenario.json
# true = le robot remplit le portail sans cliquer sur la validation finale (pour tester)
MAI_DRY_RUN=true

# ── Liaison avec l'application Digitalia
# Digitalia récupère les souscriptions avec cette clé (en-tête X-Api-Key)
DIGITALIA_API_KEY=
# Facultatif : adresse où le site envoie chaque fiche dès le paiement (signée X-Digitalia-Signature)
DIGITALIA_WEBHOOK_URL=

# ── WhatsApp Business (API Cloud de Meta) - facultatif
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_CABINET=212708295052

# ── E-mail (SMTP) - facultatif
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
